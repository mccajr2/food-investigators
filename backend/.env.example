# Local config for `./gradlew :backend:bootRun`.
# Copy to backend/.env (gitignored) and fill in values as needed.
# Production (Render) uses the same keys as dashboard env vars — see
# docs/beta/backend-hosting.md (never commit real secrets).

# Optional local port override (default 8080). Render sets PORT automatically.
# PORT=8080

# Gemini (Plan suggestions) — required for Suggest in prod; optional locally
# (heuristic fallback still works without a key).
GEMINI_API_KEY=
# Optional overrides:
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Extra CORS origins for a hosted web front (comma-separated). Localhost Vite
# origins are always allowed. Set after beta-web-hosting exists, e.g.:
# APP_CORS_ALLOWED_ORIGINS=https://food-investigators-web.onrender.com

# Prod Neon overrides (leave unset for local Docker Compose Postgres):
# SPRING_DATASOURCE_URL=jdbc:postgresql://ep-….aws.neon.tech/neondb?sslmode=require
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=

# Shared food illustrations (S3-compatible / Cloudflare R2).
# When these are unset, the backend uses an in-memory object-store double and
# iconUrl stays null unless tests call FoodIllustrationStore.store(...).
# Soft beta can leave these unset — catalog/why-chip PNGs are static in web/.
# FOOD_ILLUSTRATIONS_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# FOOD_ILLUSTRATIONS_BUCKET=food-illustrations
# FOOD_ILLUSTRATIONS_ACCESS_KEY=
# FOOD_ILLUSTRATIONS_SECRET_KEY=
# FOOD_ILLUSTRATIONS_REGION=auto
# Public CDN / r2.dev (or custom domain) base used to build iconUrl — no trailing slash.
# FOOD_ILLUSTRATIONS_PUBLIC_BASE_URL=https://cdn.example.com/food-illustrations
